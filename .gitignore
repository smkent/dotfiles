# Ignore everything except specific files and subdirectories
# This uses the method described here: http://stackoverflow.com/a/1248601
# which is based on information from here: https://gist.github.com/444295
/*
!.bash_aliases
!.bash_logout
!.bash_profile
!.bashrc
!.claude/
.claude/*
!.claude/settings.json
!.claude/statusline
!.config/
.config/*
!.config/dircolors
!.config/GIMP/
.config/GIMP/*
!.config/GIMP/3.2/
.config/GIMP/3.2/*
!.config/GIMP/3.2/scripts/
!.config/git/
!.config/google-chrome/
.config/google-chrome/*
!.config/google-chrome/NativeMessagingHosts/
.config/google-chrome/NativeMessagingHosts/*
!.config/google-chrome/NativeMessagingHosts/gpgmejson.json
!.config/herdr/
.config/herdr/*
!.config/herdr/config.toml
!.config/herdr/scripts/
!.config/mise/
.config/mise/*
!.config/mise/conf.d/
!.config/mise/hooks/
!.config/mise/config.toml
!.config/ruff/
!.config/smkent/
.config/smkent/*
!.config/smkent/dotfiles/
!.config/tmux/
!.config/worktrunk/
!.ctags
!.face
!.github/
!.gitignore
!.gnupg/
.gnupg/*
!.gnupg/gpg.conf
!.gnupg/gpg-agent.conf
!.gnupg/dirmngr.conf
!.gnupg/scdaemon.conf
!.hidden
!.local/
.local/*
!.local/state/
.local/state/*
!.local/state/smkent/
.local/state/smkent/*
!.local/state/smkent/dotfiles/
.local/state/smkent/dotfiles/*
!.local/state/smkent/dotfiles/.keep
!.mailcap
!.mozilla/
.mozilla/*
!.mozilla/native-messaging-hosts/
.mozilla/native-messaging-hosts/*
!.mozilla/native-messaging-hosts/gpgmejson.json
!.pre-commit-config.yaml
!.ruff.toml
!.screenrc
!.ssh/
.ssh/*
!.ssh/config
!.ssh/sockets
.ssh/sockets/*
!.ssh/sockets/.keep
!.vimrc
!.vim/
.vim/.netrwhist
.vim/plugged/
!.zshrc
!.zsnes/
.zsnes/*
!.zsnes/zinput.cfg
!README.md

#!/bin/sh

set -e

dir="${1:?usage: $(basename "${0}") <left|down|up|right>}"
case "${dir}" in
    left)  key="ctrl+h";;
    down)  key="ctrl+j";;
    up)    key="ctrl+k";;
    right) key="ctrl+l";;
    *) echo "$(basename "${0}"): unknown direction: ${dir}" >&2; exit 2;;
esac
herdr="${HERDR_BIN_PATH:-herdr}"

delegate_nav() {
    exec "${herdr}" plugin action invoke "vim-herdr-navigation.${dir}"
}

command -v jq >/dev/null 2>&1 || delegate_nav

pane="${HERDR_ACTIVE_PANE_ID:-${HERDR_PANE_ID:-}}"
if [ -z "${pane}" ]; then
    pane=$("${herdr}" pane current --current | jq -r '.result.pane.pane_id // empty')
fi
[ -n "${pane}" ] || exit 0

is_vim() {
    vim_re='^g?(view|l?n?vim?x?)(diff)?$'
    "${herdr}" pane process-info --pane "${pane}" 2>/dev/null \
        | jq -e --arg vim "${vim_re}" \
            '.result.process_info.foreground_processes[]?.name
             | ascii_downcase | test($vim)' >/dev/null 2>&1
}

has_neighboring_pane() {
    [ -n "$("${herdr}" pane neighbor --direction "${dir}" --pane "${pane}" \
        | jq -r '.result.neighbor.neighbor_pane_id // empty')" ]
}

if ! is_vim && ! has_neighboring_pane; then
    # No pane to navigate to, pass through original key
    exec "${herdr}" pane send-keys "${pane}" "${key}"
fi

delegate_nav

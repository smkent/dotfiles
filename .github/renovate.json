{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly"],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions", "mise", "pre-commit"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major dependencies"
    },
    {
      "description": "Pinned: not all releases have assets for every platform",
      "matchManagers": ["mise"],
      "matchDepNames": ["github:Yubico/yubioath-flutter"],
      "enabled": false
    }
  ]
}
